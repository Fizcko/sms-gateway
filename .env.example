# Copy to .env and replace every value. .env must never be committed.
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me
# Serial device of the modem on the host
MODEM_DEVICE=/dev/ttyUSB2
GAMMU_PIN=1234

# None | Bearer | Basic
API_SECURITY=None
# Required for Bearer and Basic
API_USERNAME=
API_PASSWORD=
# Required for Bearer
JWT_SECRET=

# Push received SMS to your application. WEBHOOK_SECRET is required with the URL.
WEBHOOK_URL=
WEBHOOK_SECRET=
# Delete SMS older than this number of days. Empty: never.
RETENTION_DAYS=
